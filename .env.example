# Copia este archivo a .env y ajusta los valores.
# No uses estas credenciales en producción.

# Entorno de la aplicación
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=facturalibre
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=facturalibre
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL para ejecutar el backend FUERA de Docker (uv run ...).
# Docker Compose construye su propia DATABASE_URL con el host "db".
DATABASE_URL=postgresql+psycopg://facturalibre:cambia_esta_clave@localhost:5432/facturalibre

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
